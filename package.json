{
  "name": "verificai-js",
  "version": "2.0.0",
  "description": "Verificador de notícias falsas com Groq e Google News RSS (Node.js)",
  "main": "server.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "rm -rf dist && mkdir -p dist && cp -r templates/. dist/ && cp -r static dist/static",
    "build:extension": "node scripts/build-extension.mjs",
    "package:extension": "node scripts/build-extension.mjs --zip",
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "npm run build:extension && node --test tests/browser/*.test.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "groq-sdk": "^0.9.0",
    "helmet": "^8.3.0",
    "rss-parser": "^3.13.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/source-serif-pro": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.64.1"
  }
}
