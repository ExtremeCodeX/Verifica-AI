{
  "manifest_version": 2,
  "name": "VerificaAI — Checagem factual",
  "version": "1.1.4",
  "description": "Verifique uma seleção ou artigo com fontes rastreáveis, somente quando você solicitar.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "scripts": ["background/main.js"], "type": "module", "persistent": true },
  "browser_action": { "default_popup": "popup/index.html", "default_title": "VerificaAI", "default_icon": "assets/icon.png" },
  "icons": { "128": "assets/icon.png" },
  "browser_specific_settings": {
    "gecko_android": { "strict_min_version": "142.0" },
    "gecko": {
      "id": "verificaai@extremecodex.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent", "authenticationInfo"] }
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'"
}
