{
  "manifest_version": 3,
  "name": "VerificaAI — Checagem factual",
  "version": "1.1.4",
  "description": "Verifique uma seleção ou artigo com fontes rastreáveis, somente quando você solicitar.",
  "minimum_chrome_version": "127",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background/main.js", "type": "module" },
  "action": { "default_popup": "popup/index.html", "default_title": "VerificaAI", "default_icon": "assets/icon.png" },
  "icons": { "128": "assets/icon.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
